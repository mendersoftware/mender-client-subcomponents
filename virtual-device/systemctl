# The Virtual Device isn't booted with systemd, entrypoint.sh supervises the
# Mender daemons instead. `mender-update check-update` and `send-inventory`
# (also used by mender-connect for the remote "Trigger update check" and
# "Trigger inventory update" actions) look up the daemon's PID via
# `systemctl show --property=MainPID mender-updated` though, so answer that
# from the PID file the supervisor writes and leave everything else to the
# real systemctl.

if [ "$1" = "show" ] && [ "$2" = "--property=MainPID" ] && [ "$3" = "mender-updated" ] && [ $# -eq 3 ]; then
    pid=$(cat /run/mender-update.pid 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        echo "MainPID=$pid"
    else
        echo "MainPID=0"
    fi
    exit 0
fi

exec /usr/bin/systemctl "$@"
